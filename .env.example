# Application Configuration

# JWT signing secret - generate a strong random string
# Example generation: openssl rand -base64 32
JWT_SECRET=

# SonarQube Configuration (optional - for code quality analysis)
SONARQUBE_ORG=
SONARQUBE_CLOUD_URL=https://sonarcloud.io
SONARQUBE_TOKEN=
SONARQUBE_IDE_PORT=64120

# Database Seeding (optional - only needed for initial seed data)
# If not set, admin/user accounts and sample reviews will not be created
# These are used once during application startup
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
